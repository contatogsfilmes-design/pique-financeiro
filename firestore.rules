rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lista fixa de quem pode entrar. Pra liberar mais alguém, adiciona
    // o e-mail da conta Google da pessoa numa linha nova aqui.
    function isAllowed() {
      return request.auth != null && request.auth.token.email in [
        'contatogsfilmes@gmail.com',
        'henriqueronanc@gmail.com'
      ];
    }

    // Estado compartilhado da empresa (contas, clientes, funcionários, tags, notas).
    match /empresas/pique/estado/{docId} {
      allow read, write: if isAllowed();
    }

    // Perfil de cada pessoa (nome, foto) — qualquer um do time vê todo mundo,
    // mas só edita o próprio.
    match /empresas/pique/perfis/{email} {
      allow read: if isAllowed();
      allow write: if isAllowed() && request.auth.token.email == email;
    }
  }
}
